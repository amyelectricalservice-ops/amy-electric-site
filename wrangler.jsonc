{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amy-electric-site",
  "main": "worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-05-21",
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "amyelectric.com/*", "zone_name": "amyelectric.com" },
    { "pattern": "www.amyelectric.com/*", "zone_name": "amyelectric.com" }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
