{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amy-electric-site",
  "main": "worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-10-14",
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  // No zone routes on purpose: the `amyelectric.com` routes belong to the
  // `amy-electric-seo` edge wrapper (see seo-worker/wrangler.jsonc), which
  // proxies to this Worker via the ORIGIN service binding. Declaring the routes
  // here would take them back from the wrapper on the next deploy. This Worker
  // is reached only through that binding (and its workers.dev subdomain).
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amy-electric-photos-db",
      "database_id": "78716702-1940-44e1-acb1-0d669bf6484b"
    },
    {
      "binding": "CONFIRMED_DB",
      "database_name": "amy-electric-confirmed-db",
      "database_id": "6c52230d-3c8b-44d5-b1b5-118c57e0ab89"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "estimates"
    },
    {
      "binding": "ESTIMATES",
      "bucket_name": "estimates"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": ["0 16 * * *"]
  }
}
