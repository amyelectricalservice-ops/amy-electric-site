{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amy-electric-site",
  "main": "worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-10-14",
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  // This Worker serves amyelectric.com directly. The route used to belong to the
  // `amy-electric-seo` edge wrapper, which sat in front of this Worker and
  // proxied here through an ORIGIN service binding; that wrapper was retired on
  // 2026-10-18 and this Worker took the route over. The zone also carried 11
  // redundant sub-patterns (/faq, /sitemap.xml, /robots.txt, /llms.txt and the
  // service prefixes), each of which already resolved to the same Worker; they
  // were removed with it.
  "routes": [
    { "pattern": "amyelectric.com/*", "zone_name": "amyelectric.com" }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/*", "!/css/*", "!/js/*", "!/fonts/*"]
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amy-electric-photos-db",
      "database_id": "78716702-1940-44e1-acb1-0d669bf6484b"
    },
    {
      "binding": "CONFIRMED_DB",
      "database_name": "amy-electric-confirmed-db",
      "database_id": "6c52230d-3c8b-44d5-b1b5-118c57e0ab89"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "estimates"
    },
    {
      "binding": "ESTIMATES",
      "bucket_name": "estimates"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": ["0 16 * * *"]
  },
  "previews": {
    "d1_databases": [
    { "binding": "DB", "database_id": "00000000-0000-0000-0000-000000000000" },
    { "binding": "CONFIRMED_DB", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
    "r2_buckets": [
      {
        "binding": "BUCKET",
        "bucket_name": "preview-bucket"
      },
      {
        "binding": "ESTIMATES",
        "bucket_name": "preview-bucket"
      }
    ],
    "ai": {
      "binding": "AI"
    },
    "images": {
      "binding": "IMAGES"
    }
  }
}
