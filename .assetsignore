# Local secrets. .gitignore already hides these from git; without these lines
# `wrangler deploy` would upload them as public assets.
.dev.vars*
.env*

# Local tooling caches. Same reasoning as above — .gitignore keeps them out of
# git but ASSETS would still upload them (this is how .ruff_cache/ leaked).
.ruff_cache
.pytest_cache
.mypy_cache
__pycache__
*.pyc
lh-out
.playwright-mcp
.webstudio
builder
.server_pid
.server.log
*.log
wrangler-consolidate.toml

# Worker config and CLI helpers — never public.
wrangler.jsonc
wrangler.production.jsonc
wrangler.staging.jsonc
wrangler.config.ts
cloudflare.config.ts
package.json
package-lock.json
pnpm-lock.yaml
run_lighthouse_audit.sh
*.sh
*.py

# Worker-side modules. Anything not listed here is served as a public asset —
# these were reachable at /crm-handler.js, /lead-store.js, /gbp-agent.js etc.
# .assetsignore also hides *ignored* files behind a 404, which is what we want.
worker.js
contact-handler.js
contact-enrich.js
crm-cron.js
crm-espocrm.js
crm-handler.js
estimator-bundle.js
estimator-handler.js
gbp-agent.js
lead-handler.js
lead-store.js
photo-handler.js

# one-off local scripts — keep them off the public surface even though they are
# also gitignored (.gitignore hides them from git, this hides them from ASSETS)
consolidate-worker.mjs
.gitignore
.assetsignore
