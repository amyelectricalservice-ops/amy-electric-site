# Security Headers — applied to all paths
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Language: en
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com https://www.googletagmanager.com https://www.google-analytics.com https://googleads.g.doubleclick.net https://bat.bing.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://amyelectric.com https://www.google-analytics.com https://www.googletagmanager.com https://googleads.g.doubleclick.net https://bat.bing.com https://c.bing.com; connect-src 'self' https://api.mailchannels.net https://challenges.cloudflare.com https://cloudflareinsights.com https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com https://googleads.g.doubleclick.net https://www.googleadservices.com https://bat.bing.com https://c.bing.com; frame-src 'self' https://challenges.cloudflare.com https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://api.mailchannels.net;
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

# Fixed-name bundles (style.min.css, site.min.js, woff2) change on rebuild, so
# browsers AND the edge must revalidate hourly. A fixed name + year-long edge
# TTL serves the old bundle long after the deploy that fixed it (the edge
# cannot be purged — CLOUDFLARE_API_TOKEN lacks Zone > Cache Purge > Edit), so
# s-maxage=3600. Docs reserve `immutable` for fingerprinted filenames only.
/css/*
  Cache-Control: public, max-age=3600, s-maxage=3600

/js/*
  Cache-Control: public, max-age=3600, s-maxage=3600

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

# HTML pages — SUPERSEDED by worker.js HTML_CACHE_CONTROL
# (public, max-age=300, s-maxage=60, stale-while-revalidate=600), which the
# Worker sets on every HTML response and therefore wins over this block.
# Kept as a fallback for non-Worker serves only; do NOT "fix" caching here.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Sitemap and robots — cache for 1 day
/sitemap.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

/llms.txt
  Cache-Control: public, max-age=86400

# Keep workers.dev deployment URLs out of search indexes (apex is canonical).
# Placeholder pattern per https://developers.cloudflare.com/workers/static-assets/headers/
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
