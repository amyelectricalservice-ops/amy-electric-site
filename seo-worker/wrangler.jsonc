{
  // Edge SEO wrapper that fronts `amy-electric-site` for amyelectric.com.
  //
  // It owns every `amyelectric.com` zone route and proxies to the site Worker
  // through the ORIGIN service binding, rewriting HTML (title/description/
  // canonical/OG/geo tags, JSON-LD, img alt+lazy) and serving generated
  // /robots.txt, /sitemap.xml, /llms.txt, /faq, service and city pages.
  //
  // Recovered from the deployed Worker and committed so this layer is
  // version-controlled; see seo-worker/README.md.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "amy-electric-seo",
  "main": "worker.js",
  "compatibility_date": "2026-10-14",
  "workers_dev": false,
  "preview_urls": false,

  "services": [
    { "binding": "ORIGIN", "service": "amy-electric-site" }
  ],

  "routes": [
    { "pattern": "amyelectric.com/*", "zone_name": "amyelectric.com" },
    // The sub-patterns below are redundant with the catch-all above (each one
    // already resolves to this same Worker) but are kept verbatim so the config
    // mirrors the zone's current route table exactly.
    { "pattern": "amyelectric.com/troubleshooting*", "zone_name": "amyelectric.com" },
    { "pattern": "amyelectric.com/ev-charger-installation*", "zone_name": "amyelectric.com" },
    { "pattern": "amyelectric.com/faq", "zone_name": "amyelectric.com" },
    { "pattern": "amyelectric.com/rewiring*", "zone_name": "amyelectric.com" },
    { "pattern": "amyelectric.com/electrician-*", "zone_name": "amyelectric.com" },
    { "pattern": "amyelectric.com/sitemap.xml", "zone_name": "amyelectric.com" },
    { "pattern": "amyelectric.com/panel-upgrade*", "zone_name": "amyelectric.com" },
    { "pattern": "amyelectric.com/robots.txt", "zone_name": "amyelectric.com" },
    { "pattern": "amyelectric.com/llms.txt", "zone_name": "amyelectric.com" },
    { "pattern": "amyelectric.com/lighting-installation*", "zone_name": "amyelectric.com" },
    { "pattern": "amyelectric.com/electrical-inspection*", "zone_name": "amyelectric.com" }
  ]
}
