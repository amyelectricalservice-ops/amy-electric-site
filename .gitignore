*~
.antigravitycli/

# wrangler files
.wrangler
.cloudflare
.dev.vars*
!.dev.vars.example
.env*
!.env.example
lighthouse-report*.json
.omo/
.playwright-mcp/
__pycache__/
*.pyc
gallery-pipeline/processed/
gallery-pipeline/raw/
node_modules/
db/

# lighthouse local output
lh-out/
# Lighthouse audit snapshots — 234MB of regenerable JSON, stay local
audit/lighthouse/
# local lighthouse runs
audit/lighthouse/lh-*.json

# local dev server
.server_pid
.server.log

# local-only tooling checkouts and one-off scripts (never shipped)
open-seo/
.webstudio/
consolidate-worker.mjs
wrangler-consolidate.toml

# embedded local project checkouts — tracked as broken gitlinks with no
# .gitmodules, which makes `git clone --recurse-submodules` fail (Workers Builds
# died on "updating repository submodules"). Their content was never in git.
builder/
estimator-app/

# Gemini Code Assist suite installed locally. It is driven by GEMINI_API_KEY,
# which is not a repo secret, so committing it would only add failing checks.
# Un-ignore these four lines (and add the secret) to adopt it deliberately.
.github/commands/
.github/workflows/gemini-*.yml
